# EditorConfig — konsistensi lintas editor
# Docs: https://editorconfig.org

root = true

# ─── Default (semua file) ────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# ─── TypeScript / JavaScript ─────────────────────────
[*.{ts,js,mjs,cjs,tsx,jsx}]
indent_style = space
indent_size = 2
quote_type = single

# ─── JSON ────────────────────────────────────────────
[*.{json,jsonc}]
indent_style = space
indent_size = 2
insert_final_newline = true

# ─── YAML ────────────────────────────────────────────
[*.{yaml,yml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# ─── Markdown ────────────────────────────────────────
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 80

# ─── Dockerfile ──────────────────────────────────────
[Dockerfile*]
indent_style = space
indent_size = 2

# ─── Shell ───────────────────────────────────────────
[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

# ─── Makefile (wajib tab) ────────────────────────────
[Makefile]
indent_style = tab
indent_size = 4

# ─── Env ─────────────────────────────────────────────
[.env*]
insert_final_newline = true
trim_trailing_whitespace = true
