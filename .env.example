# ─── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SERVICE_NAME=api-gateway
LOG_LEVEL=debug

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=gw

# ─── JWT ────────────────────────────────────────────────
JWT_ISSUER=http://localhost:4001
JWT_AUDIENCE=api.local
JWKS_URI=http://localhost:4001/.well-known/jwks.json

# ─── Rate Limit ─────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=1000

# ─── Retry ──────────────────────────────────────────────
RETRY_MAX_RETRIES=2
RETRY_BASE_DELAY_MS=100
RETRY_MAX_DELAY_MS=2000
RETRY_JITTER_MS=50

# ─── Circuit Breaker ────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# ─── Idempotency ────────────────────────────────────────
IDEMPOTENCY_LOCK_TTL_SEC=30
IDEMPOTENCY_REPLAY_TTL_SEC=86400

# ─── Upstream ───────────────────────────────────────────
SERVICE_AUTH_URL=http://localhost:4001
SERVICE_ORDER_URL=http://localhost:4002

# Tenant registry (YAML)
TENANTS_FILE=./config/tenants.yaml
