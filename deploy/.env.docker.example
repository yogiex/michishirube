# ─────────────────────────────────────────────────────
# Docker Compose Environment — Michishirube
# Copy ke .env.docker dan sesuaikan nilainya
# ─────────────────────────────────────────────────────

# ─── Image Tag ───────────────────────────────────────
GATEWAY_TAG=latest
REDIS_TAG=7-alpine
POSTGRES_TAG=16-alpine
PGBOUNCER_TAG=1.23-alpine
PROMETHEUS_TAG=latest
GRAFANA_TAG=latest
JAEGER_TAG=latest

# ─── Port Mapping (Uncommon 73xx range) ──────────────
# Gateway
GATEWAY_PORT=7300
GATEWAY_DEBUG_PORT=7329
GATEWAY_METRICS_PORT=7301

# Redis
REDIS_PORT=7380
REDIS_UI_PORT=7381

# PgBouncer & PostgreSQL
PGBOUNCER_PORT=7382
POSTGRES_PORT=7383

# Observability
PROMETHEUS_PORT=7390
GRAFANA_PORT=7391
JAEGER_UI_PORT=7392

# OpenTelemetry
OTEL_GRPC_PORT=7317
OTEL_HTTP_PORT=7318

# ─── Credentials ─────────────────────────────────────
REDIS_PASSWORD=dev-redis-secret
POSTGRES_USER=gateway
POSTGRES_PASSWORD=dev-postgres-secret
POSTGRES_DB=gateway
GRAFANA_PASSWORD=dev-grafana-secret

# ─── App Config ──────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=michishirube

# ─── Feature Flags ───────────────────────────────────
ENABLE_MONITORING=false
ENABLE_JAEGER=false
ENABLE_PGBOUNCER=false

# ─── Network ─────────────────────────────────────────
COMPOSE_PROJECT_NAME=michishirube
